# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_MAXLEN=10000          # max messages retained per stream

# ─── DuckDB ──────────────────────────────────────────────────────────────────
DUCKDB_PATH=./data/finrisk.duckdb  # relative to the finrisk/ root

# ─── API server ──────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true                    # set false in production

# ─── Signal generator ────────────────────────────────────────────────────────
FAKE_SIGNAL_INTERVAL_SECONDS=5    # how often the fake generator emits a signal
FAKE_SIGNAL_ENABLED=true

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR

# ─── NLP engine ───────────────────────────────────────────────────────────────
NLP_MODEL_NAME=placeholder/finbert
NLP_CONFIDENCE_THRESHOLD=0.65
NLP_WORKER_ENABLED=true            # run NLP worker on API startup

# ─── Event classifier ────────────────────────────────────────────────────────
EVENT_CLASSIFIER=rule-based        # rule-based | deberta
DEBERTA_MODEL_PATH=data/models/event_deberta

# ─── Ingestion layer ──────────────────────────────────────────────────────────
INGESTION_ENABLED=false            # set true to enable live ingestion (or use --profile live)
KAGGLE_TWEETS_CSV_PATH=./data/sample/tweets.csv
KAGGLE_REPLAY_SPEED=10.0           # 1.0=real-time, 10.0=10× faster
GDELT_POLL_INTERVAL_SECONDS=900    # 15 minutes
EDGAR_POLL_INTERVAL_SECONDS=1800   # 30 minutes
STOCKTWITS_POLL_INTERVAL_SECONDS=300  # 5 minutes
INGESTION_ADAPTERS=gdelt,edgar,stocktwits,kaggle

# ─── Replay mode (offline demo — no internet required) ───────────────────────
REPLAY_MODE=false                  # set true for offline demo mode
REPLAY_SPEED_MULTIPLIER=10.0       # replay speed multiplier

# Module A price cache: false keeps demo/API startup offline and immediate.
# Set true only when yfinance access is desired and available.
PRICE_CACHE_LIVE_ENABLED=false
# SAMPLE_DATA_DIR=./data/sample    # directory for articles.jsonl / signals.jsonl

# ─── LLM explanation layer ───────────────────────────────────────────────────
LLM_PROVIDER=none                  # groq | ollama | none
GROQ_API_KEY=                      # get a free key at console.groq.com
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b

# ─── Module toggles ──────────────────────────────────────────────────────────
MC_N_PATHS=10000                   # Monte Carlo paths for Module B
MC_ENABLED=true                    # disable to speed up /inject responses
