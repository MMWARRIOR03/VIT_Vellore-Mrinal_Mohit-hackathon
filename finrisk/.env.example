# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_MAXLEN=10000          # max messages retained per stream

# ─── DuckDB ──────────────────────────────────────────────────────────────────
DUCKDB_PATH=./data/finrisk.duckdb  # relative to the finrisk/ root

# ─── API server ──────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true                    # set false in production

# ─── Signal generator ────────────────────────────────────────────────────────
FAKE_SIGNAL_INTERVAL_SECONDS=5    # how often the fake generator emits a signal
FAKE_SIGNAL_ENABLED=true

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR

# ─── NLP engine (placeholder for Task 2) ─────────────────────────────────────
NLP_MODEL_NAME=placeholder/finbert
NLP_CONFIDENCE_THRESHOLD=0.65

# ─── Ingestion layer (Task 2) ─────────────────────────────────────────────────
INGESTION_ENABLED=true
KAGGLE_TWEETS_CSV_PATH=./data/sample/tweets.csv
KAGGLE_REPLAY_SPEED=10.0                # 1.0=real-time, 10.0=10× faster
GDELT_POLL_INTERVAL_SECONDS=900         # 15 minutes
EDGAR_POLL_INTERVAL_SECONDS=1800        # 30 minutes
STOCKTWITS_POLL_INTERVAL_SECONDS=300    # 5 minutes
INGESTION_ADAPTERS=gdelt,edgar,stocktwits,kaggle   # comma-separated; remove to disable
